{
  "name": "festivo-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.js && node --check server/core.js && node --check src/core.js && node --check src/app.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google/genai": "^2.30.0",
    "express": "^5.1.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "helmet": "^8.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.12"
  }
}
